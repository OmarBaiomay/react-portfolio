# Optional reverse proxy in front of docker-compose.prod.yml (app on 127.0.0.1:3001).
# Replace b-code.tech and SSL paths.

upstream bcode_app {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name b-code.tech www.b-code.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name b-code.tech www.b-code.tech;

    ssl_certificate     /etc/letsencrypt/live/b-code.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/b-code.tech/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://bcode_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
