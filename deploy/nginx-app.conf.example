# Admin PWA at app.b-code.tech (same Docker app on 127.0.0.1:3002).
# Issue cert: certbot … -d app.b-code.tech

upstream bcode_app {
    server 127.0.0.1:3002;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.b-code.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.b-code.tech;

    ssl_certificate     /etc/letsencrypt/live/app.b-code.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.b-code.tech/privkey.pem;

    client_max_body_size 10m;

    # PWA service worker must not be cached aggressively at the edge
    location ~* (sw\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        proxy_pass http://bcode_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        proxy_pass http://bcode_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
