# Production env for docker-compose.prod.yml
# cp .env.production.example .env.production

APP_PORT=3001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bcode

JWT_SECRET=change-me-to-a-long-random-secret

# Public site origin(s), comma-separated (e.g. https://b-code.tech)
CLIENT_ORIGIN=https://b-code.tech

# Lock signup after first admin exists
ALLOW_PUBLIC_SIGNUP=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase service account JSON (single line)
FIREBASE_SERVICE_ACCOUNT_JSON=
