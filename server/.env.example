PORT=5001
NODE_ENV=dev

# PostgreSQL (docker compose maps host 5434 → container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/bcode

JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated browser origins (dev defaults already include localhost)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Set to false in production after creating the first admin
ALLOW_PUBLIC_SIGNUP=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: full Firebase service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON=
